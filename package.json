{
  "name": "pms-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "server/src/**/*.ts": [
      "prettier --write"
    ],
    "client/src/**/*.{ts,tsx}": [
      "npx prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
